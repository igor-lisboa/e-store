{
  "openapi": "3.0.3",
  "info": {
    "title": "e-store API",
    "version": "1.0.1",
    "description": "JSON read endpoints for the storefront. Sign in at /account in the same browser before calling protected endpoints. Swagger UI reuses the session cookie; browsers do not allow setting Cookie headers through the Authorize dialog."
  },
  "servers": [
    {
      "url": "../",
      "description": "The application hosting this specification."
    }
  ],
  "tags": [
    {
      "name": "Products"
    },
    {
      "name": "Categories"
    },
    {
      "name": "Users",
      "description": "Listing requires administrator access. Individual accounts are readable by their owner or an administrator."
    }
  ],
  "paths": {
    "/api/products/": {
      "get": {
        "operationId": "listProducts",
        "tags": [
          "Products"
        ],
        "summary": "List products",
        "responses": {
          "200": {
            "description": "Successful request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    },
    "/api/products/{productId}": {
      "get": {
        "operationId": "getProduct",
        "tags": [
          "Products"
        ],
        "summary": "Find a product",
        "responses": {
          "200": {
            "description": "Successful request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          }
        },
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          }
        ],
        "description": "Returns 404 when the requested resource does not exist."
      }
    },
    "/api/categories/": {
      "get": {
        "operationId": "listCategories",
        "tags": [
          "Categories"
        ],
        "summary": "List categories",
        "responses": {
          "200": {
            "description": "Successful request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          }
        }
      }
    },
    "/api/users/": {
      "get": {
        "operationId": "listUsers",
        "tags": [
          "Users"
        ],
        "summary": "List accounts (administrator only)",
        "responses": {
          "200": {
            "description": "Successful request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/api/users/{userId}": {
      "get": {
        "operationId": "getUser",
        "tags": [
          "Users"
        ],
        "summary": "Find an account (owner or administrator)",
        "responses": {
          "200": {
            "description": "Successful request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          }
        ],
        "description": "Returns 404 when the requested resource does not exist."
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "$ref": "schemas/product.json"
      },
      "User": {
        "$ref": "schemas/user.json"
      },
      "Category": {
        "$ref": "schemas/category.json"
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID",
        "description": "Existing browser session established through the account sign-in form."
      }
    },
    "responses": {
      "Error400": {
        "$ref": "responses/error400.json"
      },
      "Error401": {
        "$ref": "responses/error401.json"
      },
      "Error403": {
        "$ref": "responses/error403.json"
      },
      "Error500": {
        "$ref": "responses/error500.json"
      },
      "Error404": {
        "$ref": "responses/error404.json"
      }
    }
  }
}
